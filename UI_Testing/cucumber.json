{
  "default": {
      "paths": [
          "tests/features/"
      ],
      "require": [
          "tests/steps/*.js"
      ],
      "formatOptions": {
          "snippetInterface": "async-await",
          "resultsDir": "allure-results"

      },
      "format": [
          [
              "html",
              "cucumber-report.html"
          ],
          "summary",
          "progress-bar",
          "json:./cucumber-report.json",
          "allure-cucumberjs/reporter"
      ]
  }
}